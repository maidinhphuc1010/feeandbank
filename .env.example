# Copy to .env in PowerShell: Copy-Item .env.example .env
NODE_ENV=development
FEE_SERVICE_PORT=4001
BANK_SERVICE_PORT=4002
# Fee calls this URL; each attempt has a 1000ms timeout.
BANK_URL=http://127.0.0.1:4002
# Backward-compatible aliases used if service-specific ports are not set.
SERVICE1_PORT=4001
SERVICE2_PORT=4002
# Bank total charge cap (default: 20,000,000)
BANK_LIMIT=20000000
# Delay new successful charge responses without blocking the event loop.
# Charge is committed before the delay; idempotent replay returns immediately.
DELAY_MS=0
# Probability [0,1]: disconnect AFTER commit / HTTP 503 BEFORE commit.
DROP_RATE=0
FAIL_RATE=0
# Set true to simulate an unavailable bank response for all charge attempts.
BANK_FAIL=false
# Static failure flag: fails new charges until disabled and Bank restarted.
BANK_FAIL_NEXT=false
